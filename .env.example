# Ollama endpoint (override config.yaml)
# OLLAMA_BASE_URL=http://localhost:11434

# Anthropic backend (config.yaml: brain.provider: anthropic)
# Ollamaが使えない環境(モデルレジストリ遮断など)での実行経路
# ANTHROPIC_API_KEY=

# OPENAI_API_KEY=

# OpenAI互換サーバー (config.yaml: brain.provider: openai_compatible)
# Phase 5 で TTT-Mamba 等を vLLM/llama.cpp server で配信する場合に、
# 認証が必要なサーバーのみ設定（ローカルサーバーは通常不要）
# TITANS_LLM_API_KEY=

# --- 株価通知 (stock_notify.py) ---
# LINE Messaging API の push に使用 (LINE Notify は 2025-03 で終了)。
# LINE Developers でチャネルを作成し、長期のチャネルアクセストークンを発行する。
# LINE_CHANNEL_ACCESS_TOKEN=
# 送信先の userId / groupId (友だち追加済みユーザー or Bot が参加するグループ)
# LINE_TO=

# --- LINE Bot (双方向・line_bot.py) を使う場合のみ ---
# Webhook の署名検証に使う。LINE Developers のチャネル基本設定にある「チャネルシークレット」
# LINE_CHANNEL_SECRET=
